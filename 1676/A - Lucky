#include<bits/stdc++.h>
 
using namespace std;
 
void solve(){
    string s;
    cin >> s;
    int sum1 = (int)(s[0]+s[1]+s[2]-3*'0');
    int sum2 = (int)(s[3]+s[4]+s[5]-3*'0');
    if(sum1==sum2) cout<<"YES"<<"
";
    else cout<<"NO"<<"
";
}
 
int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    cout.tie(nullptr);
    
    int n;
    cin >> n;
    while(n){
        solve();
        n--;
    }
    return 0;
}