#include<bits/stdc++.h>
 
using namespace std;
 
void solve(){
    string s;
    cin >> s;
    
    int n = s.size();
    if(n%2!=0) cout<<"NO"<<"
";
    else{
        int i = 0;
        int j = n/2;
        while(j<n){
            if(s[i]!=s[j]){
                cout<<"NO"<<"
";
                return;
            }
            i++;
            j++;
        }
        cout<<"YES"<<"
";
    }
}
 
int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    cout.tie(nullptr);
    
    int n;
    cin >> n;
    while(n){
        solve();
        n--;
    }
    return 0;
}