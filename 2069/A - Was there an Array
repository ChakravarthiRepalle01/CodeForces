#include<iostream>
#include<vector>
 
using namespace std;
 
void solve(){
    int totalLength;
    cin>> totalLength;
    
    vector<int> arr;
    
    for(int i = 0 ;i<totalLength-2 ; i++){
        int ele;
        cin >> ele;
        arr.push_back(ele);
    }
    
    if((totalLength-2)<3){
        cout << "YES" <<"
"; 
        return;
    }
    
    
    for(int i = 0 ; i<=totalLength-5 ; i++){
        if(arr[i]==1 && arr[i+1]==0 && arr[i+2]==1){
            cout<<"NO"<<"
";
            return;
        }
    }
    
    cout<<"YES"<<"
";
}
 
int main(){
    int noOfTestCases;
    cin >> noOfTestCases;
    while(noOfTestCases){
        solve();
        noOfTestCases--;
    }
    return 0;
}